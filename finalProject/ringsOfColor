def normalizeField(field):
    for y in range(0, fieldCount):
        for x in range(0, fieldCount):
            field[x][y].axis *= 1.5
            if(mag(field[x][y].axis) > fieldDA):
                field[x][y].axis = hat(field[x][y].axis)*fieldDA



